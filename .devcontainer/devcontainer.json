{
  "name": "OpenAlgo Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [5000, 8765],
  "portsAttributes": {
    "5000": {
      "label": "OpenAlgo Web App",
      "onAutoForward": "openBrowser"
    },
    "8765": {
      "label": "OpenAlgo WebSocket"
    }
  },
  "postCreateCommand": "git clone --depth=1 https://github.com/marketcalls/openalgo.git /workspaces/openalgo-runtime && bash /workspaces/openalgo/.devcontainer/setup.sh"
}